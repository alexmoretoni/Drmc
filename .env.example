# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Projeto Atenção — Configuração do receptor de envelopes criptografados (servidor)
# Chave hexadecimal de 32 bytes para assinatura HMAC-SHA256 dos links de convite
INVITE_KEY=""
# Hash SHA-256 hexadecimal do token administrativo enviado no cabeçalho X-Polar-Token
ADMIN_TOKEN_SHA256=""
# Diretório fora da pasta pública para armazenar envelopes JSON criptografados
ENVELOPE_DATA_DIR="./data/envelopes"
MAX_BYTES=3145728
MAX_FILES=600
